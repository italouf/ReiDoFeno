# Copie para `infra/.env` (ignorado pelo Git).
# Este arquivo é lido pelo Docker Compose para interpolar o compose.
# NÃO coloque segredos de produção aqui; use o ambiente do servidor.

DB_PASSWORD=reidofeno

# Desenvolvimento/staging local
APP_DOMAIN=localhost
STAGING_DOMAIN=staging.localhost
ACME_EMAIL=admin@reidofeno.com.br
HSTS_MAX_AGE=0
TZ=America/Bahia

# Interface de publicação do runserver em dev. Loopback por padrão; use
# 0.0.0.0 somente se precisar acessar de outro dispositivo da rede.
DOCKER_DEV_BIND=127.0.0.1

# Produção (exemplo):
# APP_DOMAIN=reidofeno.com.br
# STAGING_DOMAIN=staging.reidofeno.com.br
# HSTS_MAX_AGE=31536000
