# Copie para `infra/.env.smoke` (ignorado pelo Git).
# Configuração exclusiva do projeto descartável `reidofeno_smoke`.
DB_PASSWORD=smoke-only

# A base Compose usa este arquivo no env_file de web/cron.
APP_ENV_FILE=.env.docker.smoke

APP_DOMAIN=localhost
STAGING_DOMAIN=staging.localhost
ACME_EMAIL=admin@example.invalid
HSTS_MAX_AGE=0
TZ=America/Bahia

# Portas locais alternativas: não disputam 80/443 da stack de dev.
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443
