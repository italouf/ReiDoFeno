# Copie para `.env.docker.smoke` na raiz (ignorado pelo Git).
# Credenciais e configuração exclusivas do projeto descartável de smoke.
# Não use tokens, SMTP ou credenciais reais aqui.

DJANGO_SECRET_KEY=smoke-only-troque-esta-chave-com-mais-de-50-caracteres
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,staging.localhost
CSRF_TRUSTED_ORIGINS=https://localhost:8443,https://staging.localhost:8443
SITE_URL=https://localhost:8443

# Staging local + simuladores + sem provedores reais.
DJANGO_ENVIRONMENT=staging
DATABASE_SSL_REQUIRE=False
DJANGO_HSTS_SECONDS=0
EMAIL_BACKEND=django.core.mail.backends.locmem.EmailBackend
DEFAULT_FROM_EMAIL=smoke@example.invalid
MERCADO_PAGO_FAKE=True
BLING_FAKE=True
MERCADOPAGO_COLLECTOR_ID=
MERCADOPAGO_LIVE_MODE=False
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
BLING_API_KEY=
SENTRY_DSN=
