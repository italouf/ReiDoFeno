# Copie para `.env.docker` na raiz (ignorado pelo Git).
# Lido pelos containers web/cron via env_file. Nunca versione segredos reais.

# Django
DJANGO_SECRET_KEY=dev-only-troque-esta-chave-com-mais-de-50-caracteres
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,www.localhost,staging.localhost,staging.reidofeno.com.br,reidofeno.com.br,www.reidofeno.com.br
CSRF_TRUSTED_ORIGINS=https://localhost,https://www.localhost,https://staging.localhost,https://staging.reidofeno.com.br,https://reidofeno.com.br,https://www.reidofeno.com.br
SITE_URL=https://localhost

# staging permite simuladores e PostgreSQL interno sem TLS.
# Em produção use DJANGO_ENVIRONMENT=production, DATABASE_SSL_REQUIRE=True,
# DJANGO_HSTS_SECONDS=31536000 e as credenciais reais.
DJANGO_ENVIRONMENT=staging
DATABASE_SSL_REQUIRE=False
DJANGO_HSTS_SECONDS=0

# E-mail (dev/staging: console)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=nao-responda@reidofeno.com.br

# Integrações simuladas em staging
MERCADO_PAGO_FAKE=True
BLING_FAKE=True
MERCADOPAGO_COLLECTOR_ID=
MERCADOPAGO_LIVE_MODE=False
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
BLING_API_KEY=

# Observabilidade
SENTRY_DSN=

# Senha do PostgreSQL: configure DB_PASSWORD em `infra/.env` (interpolação
# do compose). O valor padrão local é `reidofeno`.
